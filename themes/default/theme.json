{
  "tokens": {
    "colors": {
      "background": {
        "app": "#0F1218",
        "panel_primary": "#1A1F2A",
        "panel_secondary": "#161B24",
        "backdrop": "#18202A",
        "modal": "#1A1F2A"
      },
      "frame": {
        "card": "#3B4661",
        "card_selected": "#E4B756",
        "list": "#2D3444",
        "list_selected": "#E4B756",
        "preview": "#4A5672"
      },
      "fill": {
        "card_inner": "#212837",
        "card_inner_selected": "#212634",
        "list_inner": "#1F2634",
        "list_inner_selected": "#1D222C",
        "preview": "#313A4E",
        "accent": "#6A7AA0",
        "accent_selected": "#E8B352"
      },
      "text": {
        "primary": "#F5F1E6",
        "muted": "#939DB0",
        "highlight": "#E4B756",
        "error": "#DC7474"
      }
    },
    "spacing": {
      "xs": 6,
      "sm": 10,
      "md": 20,
      "lg": 30,
      "xl": 44,
      "xxl": 60
    }
  },
  "fonts": {
    "noto_sans": {
      "path": "assets/fonts/NotoSans-Regular.ttf"
    },
    "superstar": {
      "path": "assets/fonts/superstar.ttf"
    }
  },
  "typography": {
    "chrome": {
      "family": "noto_sans",
      "size": 16,
      "line_height": 20,
      "bitmap_scale": 2
    },
    "caption": {
      "family": "noto_sans",
      "size": 16,
      "line_height": 20,
      "bitmap_scale": 2
    },
    "body": {
      "family": "noto_sans",
      "size": 20,
      "line_height": 26,
      "bitmap_scale": 3
    },
    "section": {
      "family": "superstar",
      "size": 24,
      "line_height": 30,
      "bitmap_scale": 3
    },
    "title": {
      "family": "superstar",
      "size": 30,
      "line_height": 36,
      "bitmap_scale": 4
    },
    "hero": {
      "family": "superstar",
      "size": 42,
      "line_height": 48,
      "bitmap_scale": 5
    },
    "brand": {
      "family": "superstar",
      "size": 50,
      "line_height": 56,
      "bitmap_scale": 6
    }
  },
  "system_icons": {
    "nes": "assets/icons/systems/fc.png",
    "megadrive": "assets/icons/systems/md.png"
  },
  "styles": {
    "types": {
      "screen": {
        "background_color": "$colors.background.app",
        "padding": "$spacing.xl"
      },
      "panel": {
        "padding": 0,
        "border_width": 0
      },
      "stack": {
        "gap": "$spacing.md"
      },
      "text": {
        "font_role": "body",
        "text_color": "$colors.text.primary"
      },
      "list": {
        "gap": "$spacing.md"
      },
      "image": {
        "padding": 0,
        "border_width": 0
      }
    },
    "classes": {
      "screen-brand": {
        "font_role": "brand",
        "text_color": "$colors.text.primary"
      },
      "screen-title": {
        "font_role": "hero",
        "text_color": "$colors.text.primary"
      },
      "screen-subtitle": {
        "font_role": "caption",
        "text_color": "$colors.text.muted"
      },
      "section-title": {
        "font_role": "section",
        "text_color": "$colors.text.primary"
      },
      "detail-title": {
        "font_role": "title",
        "text_color": "$colors.text.primary",
        "wrap": true,
        "max_lines": 2
      },
      "metadata-line": {
        "font_role": "chrome",
        "text_color": "$colors.text.muted"
      },
      "body-copy": {
        "font_role": "body",
        "text_color": "$colors.text.muted",
        "wrap": true,
        "max_lines": 10
      },
      "status-bar-root": {
        "background_color": "#161B24",
        "border_color": "#2D3444",
        "border_width": 1,
        "padding": {
          "left": "$spacing.lg",
          "right": "$spacing.lg",
          "top": "$spacing.md",
          "bottom": "$spacing.md"
        }
      },
      "status-brand": {
        "font_role": "section",
        "text_color": "$colors.text.highlight"
      },
      "status-context": {
        "font_role": "chrome",
        "text_color": "$colors.text.muted"
      },
      "status-meta": {
        "font_role": "chrome",
        "text_color": "$colors.text.primary"
      },
      "menu-backdrop": {
        "background_color": "$colors.background.backdrop",
        "border_color": "$colors.frame.preview",
        "border_width": 1,
        "padding": "$spacing.xxl"
      },
      "panel-primary": {
        "background_color": "$colors.background.panel_primary",
        "padding": "$spacing.lg"
      },
      "panel-primary-active": {
        "border_color": "$colors.frame.card_selected",
        "border_width": 2
      },
      "panel-secondary": {
        "background_color": "$colors.background.panel_secondary",
        "padding": "$spacing.lg"
      },
      "panel-secondary-active": {
        "border_color": "$colors.frame.card_selected",
        "border_width": 2
      },
      "modal-panel": {
        "background_color": "$colors.background.modal",
        "border_color": "$colors.frame.preview",
        "border_width": 1,
        "padding": "$spacing.xl"
      },
      "empty-title": {
        "font_role": "section",
        "text_color": "$colors.text.primary"
      },
      "empty-body": {
        "font_role": "body",
        "text_color": "$colors.text.muted",
        "wrap": true,
        "max_lines": 4
      },
      "menu-card-frame": {
        "background_color": "$colors.frame.card",
        "padding": "$spacing.sm"
      },
      "menu-card-frame-selected": {
        "background_color": "$colors.frame.card_selected"
      },
      "menu-card-inner": {
        "background_color": "$colors.fill.card_inner",
        "padding": "$spacing.lg"
      },
      "menu-card-inner-selected": {
        "background_color": "$colors.fill.card_inner_selected"
      },
      "menu-card-title": {
        "font_role": "title",
        "text_color": "$colors.text.primary",
        "truncate": true
      },
      "menu-card-status": {
        "font_role": "caption",
        "text_color": "$colors.text.muted"
      },
      "menu-card-hint": {
        "font_role": "caption",
        "text_color": "$colors.text.muted"
      },
      "menu-card-hint-selected": {
        "text_color": "$colors.text.highlight"
      },
      "menu-card-accent": {
        "background_color": "$colors.fill.accent",
        "height": 22
      },
      "menu-card-accent-selected": {
        "background_color": "$colors.fill.accent_selected"
      },
      "system-tile-frame": {
        "background_color": "$colors.frame.card",
        "padding": "$spacing.sm"
      },
      "system-tile-frame-selected": {
        "background_color": "$colors.frame.card_selected"
      },
      "system-tile-inner": {
        "background_color": "$colors.fill.card_inner",
        "padding": "$spacing.lg"
      },
      "system-tile-inner-selected": {
        "background_color": "$colors.fill.card_inner_selected"
      },
      "system-tile-title": {
        "font_role": "section",
        "text_color": "$colors.text.primary",
        "truncate": true
      },
      "system-tile-meta": {
        "font_role": "caption",
        "text_color": "$colors.text.muted"
      },
      "system-tile-hint": {
        "font_role": "caption",
        "text_color": "$colors.text.muted"
      },
      "system-tile-hint-selected": {
        "text_color": "$colors.text.highlight"
      },
      "system-icon": {
        "background_color": "#11151E",
        "border_color": "$colors.frame.preview",
        "border_width": 1,
        "padding": "$spacing.xs"
      },
      "browser-list-item-frame": {
        "background_color": "$colors.frame.list",
        "padding": "$spacing.xs"
      },
      "browser-list-item-frame-selected": {
        "background_color": "$colors.frame.list_selected"
      },
      "browser-list-item-inner": {
        "background_color": "$colors.fill.list_inner",
        "padding": "$spacing.sm"
      },
      "browser-list-item-inner-selected": {
        "background_color": "$colors.fill.list_inner_selected"
      },
      "browser-list-item-title": {
        "font_role": "body",
        "text_color": "$colors.text.primary",
        "truncate": true
      },
      "browser-list-item-title-selected": {
        "text_color": "$colors.text.highlight"
      },
      "preview-frame": {
        "background_color": "$colors.fill.preview",
        "border_color": "$colors.frame.preview",
        "border_width": 1,
        "padding": "$spacing.md"
      },
      "settings-item-frame": {
        "background_color": "$colors.frame.list",
        "padding": "$spacing.xs"
      },
      "settings-item-frame-selected": {
        "background_color": "$colors.frame.list_selected"
      },
      "settings-item-frame-active": {
        "background_color": "$colors.frame.card_selected"
      },
      "settings-item-inner": {
        "background_color": "$colors.fill.list_inner",
        "padding": "$spacing.md"
      },
      "settings-item-inner-selected": {
        "background_color": "$colors.fill.list_inner_selected"
      },
      "settings-item-inner-active": {
        "background_color": "$colors.fill.card_inner_selected"
      },
      "settings-item-title": {
        "font_role": "section",
        "text_color": "$colors.text.primary"
      },
      "settings-item-value": {
        "font_role": "body",
        "text_color": "$colors.text.muted"
      },
      "settings-item-hint": {
        "font_role": "chrome",
        "text_color": "$colors.text.muted"
      },
      "settings-item-hint-selected": {
        "text_color": "$colors.text.highlight"
      },
      "editor-pane-title": {
        "font_role": "title",
        "text_color": "$colors.text.primary"
      },
      "editor-pane-body": {
        "font_role": "body",
        "text_color": "$colors.text.muted",
        "wrap": true,
        "max_lines": 6
      },
      "editor-pane-hint": {
        "font_role": "chrome",
        "text_color": "$colors.text.highlight"
      },
      "editor-list-item-frame": {
        "background_color": "$colors.frame.list",
        "padding": "$spacing.xs"
      },
      "editor-list-item-frame-selected": {
        "background_color": "$colors.frame.list_selected"
      },
      "editor-list-item-frame-active": {
        "background_color": "$colors.frame.card_selected"
      },
      "editor-list-item-inner": {
        "background_color": "$colors.fill.list_inner",
        "padding": "$spacing.md"
      },
      "editor-list-item-inner-selected": {
        "background_color": "$colors.fill.list_inner_selected"
      },
      "editor-list-item-inner-active": {
        "background_color": "$colors.fill.card_inner_selected"
      },
      "editor-list-item-title": {
        "font_role": "body",
        "text_color": "$colors.text.primary"
      },
      "editor-list-item-title-selected": {
        "text_color": "$colors.text.highlight"
      },
      "editor-list-item-description": {
        "font_role": "chrome",
        "text_color": "$colors.text.muted",
        "wrap": true,
        "max_lines": 2
      },
      "status-success": {
        "font_role": "chrome",
        "text_color": "$colors.text.highlight"
      },
      "status-error": {
        "font_role": "chrome",
        "text_color": "$colors.text.error"
      }
    },
    "ids": {}
  },
  "screen_variants": {
    "main_menu": "hero"
  }
}
