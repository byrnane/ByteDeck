{
  "screen_id": "placeholder",
  "variants": {
    "default": {
      "type": "screen",
      "children": [
        {
          "type": "stack",
          "direction": "vertical",
          "align": "center",
          "height": "fill",
          "children": [
            { "type": "spacer", "height": "fill" },
            {
              "type": "panel",
              "classes": ["modal-panel"],
              "width": 560,
              "height": 240,
              "children": [
                {
                  "type": "stack",
                  "direction": "vertical",
                  "gap": "$spacing.md",
                  "children": [
                    { "type": "text", "classes": ["screen-title"], "text_bind": "title" },
                    { "type": "text", "classes": ["screen-subtitle"], "text_bind": "subtitle" },
                    { "type": "text", "classes": ["body-copy"], "text_bind": "body", "max_lines": 3 }
                  ]
                }
              ]
            },
            { "type": "spacer", "height": "fill" }
          ]
        }
      ]
    }
  }
}
